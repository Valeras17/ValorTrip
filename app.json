{
  "expo": {
    "name": "ValorTrip",
    "slug": "valortrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "valortrip",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.valortrip.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.valortrip.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "ValorTrip needs camera access to scan QR codes"
        }
      ],
      [
        "expo-watermelondb-plugin",
        {
          "disableJsi": true
        }
      ],
      "expo-sharing",
      "./plugins/withBuildConfig.js",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.20",
            "extraProguardRules": "-keep class com.nozbe.watermelondb.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "09fccc58-dc66-4ead-9765-bf99467dd697"
      }
    }
  }
}
